# Supabase project URL and publishable key, safe to expose to the browser.
# Never use a service_role or secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Enables automatic website discovery for authenticated radar members.
# Set usage limits in the provider dashboard; never prefix this key with NEXT_PUBLIC_.
TAVILY_API_KEY=
